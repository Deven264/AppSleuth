<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <!-- Event Type Badge -->
    <TextView
        android:id="@+id/tvEventType"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="API"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:textStyle="bold"
        android:background="@drawable/bg_event_badge" />

    <!-- Event Content & Metadata -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tvEventLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/argus_text_primary"
            android:textSize="13sp"
            android:textStyle="normal"
            android:ellipsize="middle"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tvEventMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/argus_text_secondary"
            android:textSize="11sp"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Outcome Status Indicator -->
    <TextView
        android:id="@+id/tvOutcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✅"
        android:textSize="14sp" />

</LinearLayout>
